# ==================================================
# Usta kg — Backend Environment Variables (example)
# Copy to `.env` (inside backend/) for local development.
# ==================================================

PROJECT_NAME="Usta kg"
ENVIRONMENT="development"

# Security
SECRET_KEY="super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ustakg_db
POSTGRES_PORT=5432

# Optional full connection URL (overrides the parts above when set)
# POSTGRES_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ustakg_db

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
