# ==========================================================
# Usta kg — Environment Variables
# Copy to `.env` for local development / Docker Compose.
#   - Local dev:      POSTGRES_SERVER=localhost
#   - Docker Compose: backend overrides POSTGRES_SERVER=db automatically.
# ==========================================================

PROJECT_NAME="Usta kg"
ENVIRONMENT="development"

# SECURITY — always replace with a strong random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ustakg_db
POSTGRES_PORT=5432

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Web — public API base baked into the Next.js build.
# In production behind nginx this is relative: /api/v1
# NEXT_PUBLIC_API_BASE=/api/v1